[Unit]
Description=Wisal RSVP Backend Service
After=network.target mysql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/wisal-backend
ExecStart=/usr/bin/node /var/www/wisal-backend/server.js
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=wisal-backend
EnvironmentFile=/var/www/wisal-backend/.env

[Install]
WantedBy=multi-user.target
